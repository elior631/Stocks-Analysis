{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvalCase",
  "type": "object",
  "required": ["id", "input", "category", "expected"],
  "properties": {
    "id": {
      "type": "string",
      "description": "מזהה ייחודי, למשל cmd_001"
    },
    "example": {
      "type": "boolean",
      "description": "true רק בשורות התבנית ב-commands.template.jsonl; לא אמור להופיע ב-commands.jsonl האמיתי"
    },
    "input": {
      "type": "string",
      "description": "הפקודה בעברית (או מעורבת), כפי שהיא נאמרת/נכתבת בפועל"
    },
    "input_mode": {
      "type": "string",
      "enum": ["text", "voice_transcript"],
      "description": "אם המקור היה הקלטה, יש לציין voice_transcript ולשקול לצרף וריאציה עם שגיאות תמלול סבירות"
    },
    "category": {
      "type": "string",
      "enum": [
        "unambiguous",
        "ambiguous",
        "multi_action",
        "time_reminder",
        "jira_epic",
        "unsupported_or_risky"
      ]
    },
    "expected": {
      "type": "object",
      "description": "התוצאה הנכונה לפי שיפוט אנושי, לא לפי מה שהמודל מחזיר",
      "properties": {
        "workspace_id": {"type": ["string", "null"]},
        "identity_id": {"type": ["string", "null"]},
        "project_id": {"type": ["string", "null"]},
        "intent": {"type": "string"},
        "epic_key": {"type": ["string", "null"]},
        "resolved_date": {"type": ["string", "null"], "description": "ISO 8601, אחרי פתרון תאריך יחסי"},
        "requires_clarification": {"type": "boolean"},
        "clarification_options": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "forbidden": {
      "type": "array",
      "items": {"type": "string"},
      "description": "תוצאות אסורות, למשל execute_without_epic, wrong_workspace_write, send_without_approval"
    },
    "source": {
      "type": "string",
      "enum": ["manual_baseline", "shadow_correction", "capability_gap"],
      "default": "manual_baseline"
    },
    "notes": {
      "type": "string"
    }
  }
}
